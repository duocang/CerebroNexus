.DS_Store
CerebroNexus.Rcheck
CerebroNexus_*.tar.gz
.direnv
.Rhistory
.Rprofile
result
vignettes/*.crb
docs
.Rproj.user
*.Rproj
tests/smoke/
.playwright-mcp/
tmp/

# local per-project memory (Loci brain) — personal, never tracked
.loci/

# shinytest2 snapshot comparison artifacts
tests/testthat/_snaps/**/*.new.png

# large public raw data — auto-downloaded by the build scripts, reproducible via
# data-raw/DATASETS.md, not tracked (only the built .crb ship)
data-raw/vdj_10x/
data-raw/vdj_10x_dextramer/
data-raw/slidetags/
data-raw/xenium/

# R's default graphics-device dump, produced by tests/vignettes that plot; a
# stray artifact, never source
Rplots.pdf
**/Rplots.pdf
# The bare `result` rule near the top of this file matches a directory of that
# name at any depth, which also swallowed the benchmark results. Those are the
# deliverable, not scratch output, so re-include them -- the directory has to be
# re-included first, because a file cannot be un-ignored while a parent
# directory of it is still excluded.
!tools/bench/result/
!tools/bench/result/*.csv
!tools/bench/result/summary.md
tools/bench/result/logs/
!tools/bench/result/CURRENT
!tools/bench/result/runs/
!tools/bench/result/runs/**/
!tools/bench/result/runs/**/*.csv
!tools/bench/result/runs/**/summary.md
!tools/bench/result/runs/**/figures/*.png
tools/bench/result/runs/**/logs/
!tools/bench/result/archive/
!tools/bench/result/archive/**/
!tools/bench/result/archive/**/*.csv
!tools/bench/result/archive/**/summary.md
!tools/bench/result/archive/**/README.md
!tools/bench/result/archive/**/figures/*.png
tools/bench/scratch/
