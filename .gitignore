# not tracked. The app serves an empty tutorial hub until they are built.
inst/shiny/v1.4/www/tutorials/
# render intermediates left in vignettes/ if a render is interrupted
vignettes/site_libs/
vignettes/.tmp_render_*
vignettes/*.html
