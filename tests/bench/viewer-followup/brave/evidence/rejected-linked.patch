diff --git a/tests/testthat/test-coordinated-views.R b/tests/testthat/test-coordinated-views.R
index a8858307..e596cb31 100644
--- a/tests/testthat/test-coordinated-views.R
+++ b/tests/testthat/test-coordinated-views.R
@@ -62,6 +62,27 @@ if (have_bundle) {
