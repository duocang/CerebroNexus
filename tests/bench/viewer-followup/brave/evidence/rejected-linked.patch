 }
 
+test_that("canonical trajectory supplement preserves barcode mapping and fallback", {
+  env <- new.env(parent = cv_env)
+  sys.source(bundle_file, envir = env)
+  index <- c(4L, 2L, 1L)
+  env$viewerPackTrajectoryIndex <- function(...) index
+  crb <- list(
+    getMethodsForTrajectories = function() "m",
+    getNamesOfTrajectories = function(...) "t",
+    getTrajectory = function(...) list(meta = data.frame(
+      DR_1 = c(1.12345, NA, 0), DR_2 = c(9, 4.56789, -1),
+      row.names = c("d", "b", "a")
+    ))
+  )
+  expected <- env$cv_build_trajectories(crb, c("a", "b", "c", "d"))
+  expect_identical(env$cv_build_trajectories(crb, 1:4, list()), expected)
+  for (invalid in list(c(4L, 4L, 1L), c(4L, NA, 1L), c(5L, 2L, 1L), NULL)) {
+    index <- invalid
+    expect_null(env$cv_build_trajectories(crb, 1:4, list()))
+  }
+})
